# Core application
PUBLIC_BASE_URL=https://api.example.com

# JWT tenant authentication
GENERATION_AUTH_ENABLED=false
DEFAULT_TENANT_ID=public
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_AUDIENCE=
JWT_ISSUER=

# Redis and Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300
CELERY_WORKER_DISABLE_MINGLE=0
JOB_STATE_TTL_SECONDS=604800
IDEMPOTENCY_TTL_SECONDS=604800
MAX_ACTIVE_JOBS_PER_TENANT=10
MAX_ACTIVE_JOBS_GLOBAL=100

# AI document webhook; use the complete extension-less endpoint URL
WEBHOOK_ROOT_URL=https://api.visa26.com/webhooks/documents
AI_DOC_WEBHOOK_SECRET=replace-with-shared-secret
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=8

# Evidence limits and optional storage-domain allowlist
MAX_FILES_PER_JOB=25
MAX_FILE_SIZE_BYTES=52428800
MAX_TOTAL_DOWNLOAD_BYTES=262144000
MAX_PAGES_PER_JOB=1000
FILE_DOWNLOAD_CONNECT_TIMEOUT=5
FILE_DOWNLOAD_READ_TIMEOUT=30
FILE_DOWNLOAD_MAX_REDIRECTS=3
FILE_DOWNLOAD_ALLOWED_DOMAINS=

# Standalone S3 layer (not connected to generation yet)
AWS_S3_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_PRESIGNED_URL_EXPIRY_SECONDS=900
# Prefer IAM roles in production. These standard variables are optional locally.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
RUN_S3_LIVE_TESTS=0
AWS_S3_TEST_BUCKET_NAME=

# Draft verification
VERIFICATION_MODEL=o3-mini
ENABLE_MODEL_VERIFICATION=true
OCR_MODEL=gpt-4.1-mini
# Logging
GENERATION_LOG_PREVIEW_CHARS=2000
# Identity evidence checks: strict | warn | off
# - strict: fail generation if names aren't found in extracted text
# - warn: log + continue (default)
# - off: skip scanning evidence for names (recommended if frontend already validates identity)
IDENTITY_EVIDENCE_POLICY=warn

# Local all-in-one Docker development only
RUN_LOCAL_REDIS=1
